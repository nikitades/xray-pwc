# sshd as abc, inside the container's network: only the tunnel reaches it.
Port 2222
HostKey /app/state/ssh/ssh_host_ed25519_key
AuthorizedKeysFile /app/state/ssh/authorized_keys
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
PrintMotd no
PidFile none
Subsystem sftp internal-sftp
