#!/bin/bash
# Caddy between Alloy and Prometheus, a new connection per request, for
# networks that freeze a long connection. Only with AIO_RELAY=true.
. /usr/local/lib/aio/common.sh
[[ ${AIO_RELAY:-false} == true ]] || idle "relay is off" 86400
bin=$(release_bin caddy)
[[ -n $bin ]] || idle "no release yet: run probes.yml"
[[ -f $STATE/relay/Caddyfile ]] || idle "no $STATE/relay/Caddyfile"
export HOME=$STATE/relay XDG_DATA_HOME=$STATE/relay XDG_CONFIG_HOME=$STATE/relay
exec "$bin" run --config "$STATE/relay/Caddyfile" --adapter caddyfile
