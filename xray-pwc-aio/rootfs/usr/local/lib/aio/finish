#!/bin/bash
# finish <service> <exit code> <signal>: run by s6 when a service stops.
# A stop on request is normal: killed by TERM/INT (code 256), or a script that
# traps TERM and exits 0. Anything else is logged.
svc=$1 code=$2 sig=$3
if [[ $svc == wg ]]; then
	/usr/bin/wg-quick down /app/state/wg/vpnc-net.conf >/dev/null 2>&1 || true
fi
if [[ $code == 0 || ( $code == 256 && ( $sig == 15 || $sig == 2 ) ) ]]; then
	exit 0
fi
if [[ $code == 256 ]]; then
	echo "WARN service_exit service=$svc signal=$sig"
else
	echo "WARN service_exit service=$svc code=$code"
fi | /usr/local/bin/aio-log s6
exit 0
