#!/bin/bash
# The checker, as the unprivileged user abc, with the links from Ansible.
. /usr/local/lib/aio/common.sh
[[ -x $CURRENT/venv/bin/xray-tun-pwc ]] || idle "no release yet: run probes.yml"
has_links "$STATE/links.txt" || idle "no links in $STATE/links.txt"
set -a
# shellcheck source=/dev/null
[[ -f $STATE/pwc.env ]] && . "$STATE/pwc.env"
set +a
export PWC_CONFIG_PATH=$STATE/links.txt PWC_INSTANCE=$AIO_NODE \
	PWC_XRAY_TUN_CONNECT_BIN=$CURRENT/bin/xray-tun-connect \
	PLAYWRIGHT_BROWSERS_PATH=$(cat "$CURRENT/browsers-path" 2>/dev/null || echo /ms-playwright) \
	PYTHONUNBUFFERED=1 HOME=/tmp
exec s6-setuidgid abc "$CURRENT/venv/bin/xray-tun-pwc"
