# The xray-pwc-net probe {{ inventory_hostname }} ({{ pwc_net_ip }}). Made by xray-pwc-net-join.yml.
# PRIVATE: PWC_JOIN holds the probe's xray-pwc-net key. In a folder of its own on the probe:
#   docker compose up -d
# The same file on Linux, macOS and Windows. Everything the probe keeps is in the
# volume app: the token is read on its first start only, and from then on Ansible
# manages the probe through xray-pwc-net. The log: docker compose logs -f
name: xray-pwc-aio
services:
  aio:
    image: {{ aio_image }}
    container_name: xray-pwc-aio
    hostname: {{ inventory_hostname }}
    restart: unless-stopped
    # For the tunnel: the container's own network, not the host's.
    cap_add: [NET_ADMIN]
    devices: [/dev/net/tun]
    # Chromium runs out of Docker's default 64 MB on heavy pages.
    shm_size: 512m
{% if probe_dns %}
    dns: {{ probe_dns | to_json }}
{% endif %}
    environment:
      PWC_JOIN: "{{ pwc_net_join_token }}"
    volumes:
      # The releases, the tools, the state (keys, links, settings, Alloy's
      # buffer) and the log. Lost, it comes back from the token and Ansible.
      - app:/app
      # The host's CPU, memory, disks and network, for Alloy.
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro

volumes:
  app:
