# {{ ansible_managed }}
# For wg setconf: keys and the peer only. The address ({{ pwc_net_ip }}/32), the MTU
# and the route to {{ pwc_net_subnet }} come from aio.env: no default route, no DNS.
[Interface]
PrivateKey = {{ pwc_net_private_key }}

[Peer]
# {{ pwc_net_server }}
PublicKey = {{ hostvars[pwc_net_server].pwc_net_public_key }}
{% if pwc_net_via %}
# Through the service links: connect-forward sends this port on to {{ pwc_net_endpoint }}.
Endpoint = 127.0.0.1:{{ pwc_net_via_port }}
{% else %}
Endpoint = {{ pwc_net_endpoint }}
{% endif %}
AllowedIPs = {{ pwc_net_subnet }}
PersistentKeepalive = {{ pwc_net_keepalive }}
