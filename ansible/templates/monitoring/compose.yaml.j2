# {{ ansible_managed }}
name: vpn-monitoring

services:
  prometheus:
    image: {{ prom_image }}
    container_name: vpn-prometheus
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prom_retention_time }}
      - --storage.tsdb.retention.size={{ prom_retention_size }}
      - --web.enable-remote-write-receiver
    # No auth: only the loopback and the xray-pwc-net tunnel reach it.
    ports:
      - "127.0.0.1:{{ prom_port }}:9090"
      - "{{ pwc_net_ip }}:{{ prom_port }}:9090"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus

  grafana:
    image: {{ grafana_image }}
    container_name: vpn-grafana
    restart: unless-stopped
    env_file: grafana.env
    ports:
      - "127.0.0.1:{{ grafana_port }}:3000"
    volumes:
      - grafana_data:/var/lib/grafana

  # Names in {{ pwc_net_domain }} for the xray-pwc-net peers; everything else is forwarded.
  coredns:
    image: {{ coredns_image }}
    container_name: vpn-coredns
    restart: unless-stopped
    command: ["-conf", "/etc/coredns/Corefile"]
    ports:
      - "{{ pwc_net_ip }}:53:53/udp"
      - "{{ pwc_net_ip }}:53:53/tcp"
    # A directory, not files: CoreDNS rereads them, and a mounted file would
    # keep the old version after the template replaces it.
    volumes:
      - ./coredns:/etc/coredns:ro

volumes:
  prometheus_data:
  grafana_data:
