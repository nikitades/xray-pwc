# {{ ansible_managed }}
# Carries the vpnc-net tunnel through the service links, one at a time, on
# 127.0.0.1:{{ vpnc_net_via_port }}. With several links, the next one takes the port
# when {{ vpnc_net_via_health_url }} fails 3 times in a row.
[Unit]
Description=vpnc-net tunnel transport through the service links
After=network-online.target nss-lookup.target
Wants=network-online.target nss-lookup.target

[Service]
# Links from a file, not a pipe: on a pipe xray-tun-connect stops at end of input.
# No xray log: stderr is a journald socket, which xray cannot open.
ExecStart={{ vpnc_net_bin_dir }}/xray-tun-connect -stdin-links -forward {{ vpnc_net_endpoint }} -listen 127.0.0.1 -start-port {{ vpnc_net_via_port }} -xray-log-level none -health-url {{ vpnc_net_via_health_url }}
StandardInput=file:{{ vpnc_net_conf_dir }}/service_links.txt
StandardOutput=journal
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
