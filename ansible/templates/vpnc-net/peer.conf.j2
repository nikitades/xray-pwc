# {{ inventory_hostname }}: import into the AmneziaWG app, then delete this file:
# it holds the private key. Only {{ vpnc_net_subnet }} goes through the tunnel.
[Interface]
PrivateKey = {{ vpnc_net_private_key }}
Address = {{ vpnc_net_ip }}/32
MTU = {{ vpnc_net_mtu }}
{% include 'obfuscation.j2' %}

[Peer]
# {{ vpnc_net_server }}
PublicKey = {{ hostvars[vpnc_net_server].vpnc_net_public_key }}
Endpoint = {{ vpnc_net_endpoint }}
AllowedIPs = {{ vpnc_net_subnet }}
PersistentKeepalive = {{ vpnc_net_keepalive }}
