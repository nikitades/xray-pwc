#!/bin/bash
# Installs the vpnc-net tunnel for {{ inventory_hostname }}, exactly as probes.yml does,
# so Ansible takes the machine over without changes. Runs as root from join.sh.
set -euo pipefail
cd "$(dirname "$0")"
fail() { echo "vpnc-net: $*" >&2; exit 1; }

# Check everything first: a machine that does not fit stays untouched.
[[ $(uname -s) == Linux ]] || fail "this machine is not Linux"
[[ -d /run/systemd/system ]] || fail "systemd is required"
[[ $(uname -m) == {{ vpnc_net_join_machine }} ]] \
	|| fail "this file is for {{ vpnc_net_join_machine }}, the machine is $(uname -m): make another with vpnc-net-join.yml -e arch=..."
for tool in ip iptables python3; do
	command -v "$tool" >/dev/null || fail "$tool is missing, install it first"
done
python3 vpnc_net_check_subnet.py {{ vpnc_net_subnet }} {{ vpnc_net_interface }} || fail "pick another vpnc_net_subnet"

install -d -m 0755 {{ vpnc_net_bin_dir }}
install -m 0755 bin/amneziawg-go bin/awg bin/awg-quick {{ vpnc_net_bin_dir }}/
install -d -m 0700 {{ vpnc_net_conf_dir }}
install -m 0600 {{ vpnc_net_interface }}.conf {{ vpnc_net_conf_dir }}/
install -m 0700 firewall.sh {{ vpnc_net_conf_dir }}/
install -m 0644 vpnc-net.service /etc/systemd/system/vpnc-net.service
{% if vpnc_net_via %}
install -m 0755 bin/xray-tun-connect {{ vpnc_net_bin_dir }}/
install -m 0600 service_links.txt {{ vpnc_net_conf_dir }}/
install -m 0644 vpnc-net-via.service /etc/systemd/system/vpnc-net-via.service
{% endif %}
systemctl daemon-reload
{% if vpnc_net_via %}
systemctl enable --quiet vpnc-net-via
systemctl restart vpnc-net-via
{% endif %}
systemctl enable --quiet vpnc-net
systemctl restart vpnc-net

# The SSH key for Ansible, for the user who ran sudo.
user=${SUDO_USER:-root}
home=$(getent passwd "$user" | cut -d: -f6)
install -d -m 0700 -o "$user" -g "$(id -gn "$user")" "$home/.ssh"
keys=$home/.ssh/authorized_keys
touch "$keys"
grep -qxF -f ssh.pub "$keys" || cat ssh.pub >>"$keys"
chown "$user" "$keys"
chmod 0600 "$keys"
{% if ansible_user is defined %}
[[ $user == {{ ansible_user }} ]] \
	|| echo "vpnc-net: warning: Ansible will log in as {{ ansible_user }}, but the key went to $user" >&2
{% endif %}

for _ in $(seq {{ 60 if vpnc_net_via else 30 }}); do
	if {{ vpnc_net_bin_dir }}/awg show {{ vpnc_net_interface }} latest-handshakes | awk '$2 > 0 { ok = 1 } END { exit !ok }'; then
		echo "vpnc-net: OK, {{ inventory_hostname }} is {{ vpnc_net_ip }}. Next, on your machine: ansible-playbook probes.yml --limit {{ inventory_hostname }}"
		exit 0
	fi
	sleep 1
done
{% if vpnc_net_via %}
fail "installed, but no handshake with {{ vpnc_net_endpoint }} through the first service link in 60 s; vpnc-net-via goes on with the next ones: journalctl -u vpnc-net-via"
{% else %}
fail "installed, but no handshake with {{ vpnc_net_endpoint }} in 30 s: is UDP to it blocked? Then add files/probes/{{ inventory_hostname }}/service_links.txt and make the file again. See: journalctl -u vpnc-net"
{% endif %}
