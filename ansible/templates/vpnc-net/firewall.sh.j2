#!/bin/bash
# {{ ansible_managed }}
# Run by awg-quick: "up" after {{ vpnc_net_interface }} appears, "down" after it is gone.
# Admin peers: {{ vpnc_net_admin_ips | join(', ') or 'none' }}.
set -eu
ipt() { iptables -w "$@"; }
{% if inventory_hostname == vpnc_net_server %}
# Peer to peer traffic: only admin peers start connections, the rest only get answers.
case "$1" in
up)
	ipt -N VPNC-NET-FWD 2>/dev/null || ipt -F VPNC-NET-FWD
	ipt -A VPNC-NET-FWD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
{% for ip in vpnc_net_admin_ips %}
	ipt -A VPNC-NET-FWD -s {{ ip }} -j ACCEPT
{% endfor %}
	ipt -A VPNC-NET-FWD -j DROP
	ipt -C FORWARD -i {{ vpnc_net_interface }} -o {{ vpnc_net_interface }} -j VPNC-NET-FWD 2>/dev/null \
		|| ipt -I FORWARD 1 -i {{ vpnc_net_interface }} -o {{ vpnc_net_interface }} -j VPNC-NET-FWD
	;;
down)
	ipt -D FORWARD -i {{ vpnc_net_interface }} -o {{ vpnc_net_interface }} -j VPNC-NET-FWD 2>/dev/null || true
	ipt -F VPNC-NET-FWD 2>/dev/null || true
	ipt -X VPNC-NET-FWD 2>/dev/null || true
	;;
esac
{% else %}
# Admin peers may connect to anything here (SSH on any port). Everything else from
# the tunnel goes on to the host's own rules, like ufw.
case "$1" in
up)
	ipt -N VPNC-NET-IN 2>/dev/null || ipt -F VPNC-NET-IN
{% for ip in vpnc_net_admin_ips %}
	ipt -A VPNC-NET-IN -s {{ ip }} -j ACCEPT
{% endfor %}
	ipt -C INPUT -i {{ vpnc_net_interface }} -j VPNC-NET-IN 2>/dev/null \
		|| ipt -I INPUT 1 -i {{ vpnc_net_interface }} -j VPNC-NET-IN
	;;
down)
	ipt -D INPUT -i {{ vpnc_net_interface }} -j VPNC-NET-IN 2>/dev/null || true
	ipt -F VPNC-NET-IN 2>/dev/null || true
	ipt -X VPNC-NET-IN 2>/dev/null || true
	;;
esac
{% endif %}
