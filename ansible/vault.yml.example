---
# cp vault.yml.example vault.yml and fill it in. vault.yml is plain text
# and git-ignored.

vault_grafana_admin_password: "CHANGE-ME"

# vpnc-net: the keys are not here, vpnc-net-join.yml writes them to host_vars/<name>/vpnc-net.yml.
# The same on every peer. Pick your own: S1 and S2 in 15..150 with S1 + 56 != S2,
# H1..H4 four different numbers from 5 to 2147483647.
vault_vpnc_net_obfuscation:
  jc: 4
  jmin: 40
  jmax: 70
  s1: 0
  s2: 0
  h1: 0
  h2: 0
  h3: 0
  h4: 0
